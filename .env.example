# The browser never receives this URL or key. Next.js server routes call n8n.
N8N_CRM_WEBHOOK_URL=https://YOUR-N8N-DOMAIN/webhook/sanureva-crm-api
N8N_CRM_API_KEY=replace-with-the-same-token-used-by-the-n8n-gateway
NEXT_PUBLIC_CRM_POLL_MS=30000

# Required for private CRM inbox and original media; configure only in Vercel/.env.local
CRM_DASHBOARD_PASSWORD=set-a-long-unique-password
