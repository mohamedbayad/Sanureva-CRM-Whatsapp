        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body=$('CRM API').first().json.body||{}; const digits=String(body.phone||'').replace(/\\D/g,''); const phone=digits.startsWith('502')?digits:(digits.length===8?'502'+digits:digits); if(!phone) throw new Error('phone is required'); const type=String(body.type||'text').toLowerCase(); if(!['text','image','pdf','video'].includes(type)) throw new Error('invalid message type'); const message=String(body.message||''); const media=String(body.media_url||''); if(type==='text'&&!message.trim()) throw new Error('message is required'); if(type!=='text'&&!media.trim()) throw new Error('media_url is required'); return [{json:{request_id:String(body.request_id||('CRM-'+Date.now()+'-'+phone.slice(-4))),action:'SEND',phone,customer:String(body.customer_name||''),order_id:String(body.order_id||''),type,message,media_url:media,file_name:String(body.file_name||''),status:'QUEUED'}}];"
      },
